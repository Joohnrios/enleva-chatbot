# syntax=docker/dockerfile:1
# CMS Django Admin — leve (sem torch/embeddings).

ARG PYTHON_VERSION=3.12

FROM python:${PYTHON_VERSION}-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=cms.config.settings \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10002 cmsuser \
    && useradd --uid 10002 --gid cmsuser --create-home --shell /usr/sbin/nologin cmsuser

COPY cms/requirements.txt /tmp/cms-requirements.txt
RUN pip install --no-cache-dir -r /tmp/cms-requirements.txt \
    && rm /tmp/cms-requirements.txt

COPY cms ./cms
COPY knowledge ./knowledge
COPY cms/docker-entrypoint.sh /docker-entrypoint.sh

RUN chmod +x /docker-entrypoint.sh \
    && mkdir -p /app/cms/staticfiles \
    && chown -R cmsuser:cmsuser /app

USER cmsuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8001/admin/login/ >/dev/null || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
