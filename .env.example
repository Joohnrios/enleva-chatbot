# Nome exibido do bot (system prompt, respostas, widget). Troque e reinicie o serviço.
BOT_NAME=Assistente

# Provedor LLM: anthropic | openai | gemini
LLM_PROVIDER=anthropic

# Anthropic (Etapa 1 — padrão)
# IDs oficiais atuais (Claude API) — nunca hardcoded no código de negócio
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_SCOPE_MODEL=claude-haiku-4-5

# OpenAI (opcional — troque LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (opcional — troque LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Paths (relativos à raiz do projeto)
KNOWLEDGE_DIR=./knowledge
CHROMA_DIR=./data/chroma
LOG_DIR=./data/logs
LOG_RETENTION_DAYS=90
# Hora UTC do purge diário interno (Docker e bare-metal usam o mesmo agendador no processo)
LOG_PURGE_HOUR_UTC=3

# Admin: obrigatório para POST /admin/reindex
ADMIN_TOKEN=change-me-local-admin

# OBRIGATÓRIO para /chat (piloto). Mitigação anti-scanner — o valor vai para o JS
# via /config/public e é VISÍVEL no navegador. NÃO é autenticação de sessão real.
# Gere um valor longo e aleatório; deixe vazio só em testes unitários isolados.
WIDGET_API_TOKEN=change-me-widget-token

# CORS (browser) e checagem Origin/Referer do /chat
# ALLOWED_ORIGINS vazio = reutiliza CORS_ORIGINS
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://intranet.enlevasaude.com
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://intranet.enlevasaude.com

# Rate limit do /chat — defaults conservadores SEM auth de sessão (piloto controlado).
# Revisar para cima quando houver autenticação real via sessão WordPress.
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_CHAT_SESSION=15/minute

# Retrieval
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35
# Escopo local: score >= MIN → in; score < OUT_MAX → out; entre → Haiku (calibrar se preciso)
SCOPE_LOCAL_MIN_SCORE=0.28
SCOPE_LOCAL_OUT_MAX=0.18
# Contexto multi-turno em memória de processo (reinício zera; logs JSONL permanecem)
SESSION_MAX_TURNS=6
SESSION_TTL_MINUTES=60
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Reindex automático ao editar ./knowledge (volume). false = só POST /admin/reindex
KNOWLEDGE_WATCH_ENABLED=true
KNOWLEDGE_WATCH_DEBOUNCE_SECONDS=2
# true = sempre reset+reindex completo no startup/CLI (raro; use ?full=true no admin)
INGEST_FORCE_FULL=false

# --- CMS Django (dono do schema Postgres) ---
# CMS_USE_SQLITE=true  # só dev local sem Postgres / sem Docker
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,cms,enleva-cms
CMS_PORT=8001
# No compose: import knowledge/*.md ao subir o cms (idempotente)
CMS_IMPORT_ON_START=true
POSTGRES_DB=enleva_kb
POSTGRES_USER=enleva
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# FastAPI: ler kb_domain/kb_document no Postgres (canais + seeds). false = só fallback local
KB_SQL_ENABLED=true
# auto = Document publicados no Postgres se existirem; senão ./knowledge
# postgres | files forçam a fonte
INGEST_SOURCE=auto
# Vector store: pgvector (Compose) | chroma (rollback / testes locais)
VECTOR_STORE=pgvector
# Dimensão do modelo padrão paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# Redis — rate limit + sessão multi-turno (Compose: redis://redis:6379/0)
# Vazio = fallback em memória de processo (não escale réplicas sem Redis)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
